# Convergence Factory Environment Configuration
# Copy this file to .env in the project root:
#   cp .env.example .env

# ------------------------------------------------------------------------------
# 1. Target Repositories Directory (Optional)
# Default folder containing the projects/microservices to analyze.
# Can also be passed directly to run.sh, e.g.: ./run.sh /path/to/my/projects
# ------------------------------------------------------------------------------
CONVERGENCE_TARGET_DIR=""

# ------------------------------------------------------------------------------
# 2. LLM Judge Configuration (Optional)
# The pipeline includes an accurate built-in Heuristic Judge.
# To optionally enable an external LLM (Ollama, OpenAI, Azure OpenAI, Groq)
# for semantic cluster confirmation and deep clone comparison:
# ------------------------------------------------------------------------------

# LLM Endpoint:
# - Local Ollama : http://localhost:11434/api/generate (or /v1/chat/completions)
# - OpenAI       : https://api.openai.com/v1/chat/completions
# - Azure OpenAI : https://<resource>.openai.azure.com/openai/deployments/<model>/chat/completions?api-version=2024-02-15-preview
# - Groq Cloud   : https://api.groq.com/openai/v1/chat/completions
CONVERGENCE_LLM_ENDPOINT=""

# LLM Model Name:
# - Ollama : llama3.1:latest, mistral:latest, qwen2.5:latest
# - OpenAI : gpt-4o-mini, gpt-4o
CONVERGENCE_LLM_MODEL=""

# LLM API Key or Bearer Token (leave empty for local Ollama):
CONVERGENCE_LLM_KEY=""

# Alternatively, standard OPENAI_API_KEY is also recognized:
# OPENAI_API_KEY=""

# ------------------------------------------------------------------------------
# 3. Logging & Debugging
# Options: DEBUG, INFO, WARNING, ERROR (default: INFO)
# ------------------------------------------------------------------------------
CONVERGENCE_LOG_LEVEL="INFO"
